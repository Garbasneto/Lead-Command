# Nomes das variáveis de ambiente do Lead Command. SÓ NOMES, NUNCA VALORES.
# Para usar: copie para .env.local e preencha. O .env.local nunca vai para o Git.
# Nenhuma delas é usada ainda: o painel roda só com dados de demonstração.
# Regra: só o que começa com NEXT_PUBLIC_ pode chegar ao navegador. Tokens ficam no servidor.

# Supabase (Fase 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Ads e Lead Ads (Fase 1)
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Pipedrive (Fase 1)
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=

# API do Claude (Fase 2)
ANTHROPIC_API_KEY=

# Google Ads (Fase 3)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
